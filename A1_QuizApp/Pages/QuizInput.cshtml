@page
@model QuizInpModel
@{
    ViewData["Title"] = Model.Quiz.Title;
}

<h1>@Model.Quiz.Title</h1>

@if (Model.ErrMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrMessage</div>
}
else
{
<form method="post" id="quiz-form">

    @for (var i = 0; i < Model.Quiz.Questions.Count; i++)
    {
        Models.QuizQuestion q = Model.Quiz.Questions[i];
        <div>
            <legend>@(i + 1). @q.QuestionText</legend>

            @for (int o = 0; o < q.Choices.Count; o++)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio"
                           id="answer-@i-@o"
                           name="Answers[@i]"
                           value="@o" />
                    <label class="form-check-label" for="answer-@i-@o">
                        @q.Choices[o]
                    </label>
                </div>
            }
        </div>
        <br/>
    }

    <button type="submit" class="btn btn-primary">Submit quiz</button>
</form>
}
